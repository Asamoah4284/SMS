generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ACADEMIC TERM
// ─────────────────────────────────────────

model Term {
  id        String   @id @default(cuid())
  name      String   // "First Term", "Second Term", "Third Term"
  year      Int      // 2025
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  attendances        Attendance[]
  teacherAttendances TeacherAttendance[]
  results            Result[]
  feePayments        FeePayment[]
  paystackIntents    PaystackIntent[]
  feeStructures      FeeStructure[]
  assessments        Assessment[]
  termRemarks        TermRemarks[]
  bookAssignments    BookAssignment[]
  bookPayments       BookPayment[]
  bookPaystackIntents BookPaystackIntent[]
  onlineExams        OnlineExam[]

  @@unique([name, year])
  @@map("terms")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?
  password     String
  firstName    String
  lastName     String
  role         Role
  photo        String?
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile     Teacher?
  parentProfile      Parent?
  studentProfile     StudentProfile?
  permissionRequests PermissionRequest[]
  announcements      Announcement[]
  notifications      Notification[]
  digitalMaterials   DigitalMaterial[]
  payoutRequests     PayoutRequest[]

  @@map("users")
}

enum Role {
  ADMIN   // school admin — full access
  TEACHER // class + subject teacher
  PARENT  // read-only portal
  STUDENT // student portal for CBT
}

// ─────────────────────────────────────────
// TEACHER INVITATION (for onboarding)
// ─────────────────────────────────────────

model TeacherInvitation {
  id           String    @id @default(cuid())
  staffId      String    @unique  // e.g., "JK-12345"
  phone        String    @unique
  firstName    String    @default("")
  lastName     String    @default("")
  inviteCode   String    // 6-digit code sent via SMS
  codeExpiry   DateTime
  accepted     Boolean   @default(false)
  acceptedAt   DateTime?
  classId      String?   // Pre-assign as class teacher
  createdAt    DateTime  @default(now())
  createdBy    String    // Admin user ID

  @@map("teacher_invitations")
}

// ─────────────────────────────────────────
// TEACHER
// ─────────────────────────────────────────

model Teacher {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId       String  @unique  // e.g., "JK-12345"
  qualification String?

  classTeacherOf  Class?             @relation("ClassTeacher")
  subjectTeachers SubjectTeacher[]
  attendances     TeacherAttendance[]

  @@map("teachers")
}

// ─────────────────────────────────────────
// OTP LOG (for password reset)
// ─────────────────────────────────────────

model OTPLog {
  id       String    @id @default(cuid())
  phone    String
  code     String    // 6-digit OTP
  attempted Int       @default(0)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_logs")
}

// ─────────────────────────────────────────
// PARENT
// ─────────────────────────────────────────

model Parent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  homeAddress String?
  occupation  String?

  children Student[]

  @@map("parents")
}

// ─────────────────────────────────────────
// STUDENT PROFILE (portal login)
// ─────────────────────────────────────────

model StudentProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentDbId   String  @unique
  student       Student @relation(fields: [studentDbId], references: [id], onDelete: Cascade)
  mustChangePin Boolean @default(true)

  @@map("student_profiles")
}

// ─────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────

model PaystackIntent {
  id             String   @id @default(cuid())
  reference      String   @unique
  amountGhs      Float    // Gross charged to parent (incl. platform fee)
  amountPesewas  Int      // Paystack amount (minor units)
  schoolAmountGhs Float   @default(0) // Net credited to school / applied to fees
  platformFeeGhs  Float   @default(0)
  status           String   @default("PENDING") // PENDING | SUCCESS | FAILED
  callbackUrl    String?
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId         String
  term           Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  paystackAccessCode String?
  /** Empty = settle across all fee lines in order; otherwise only these fee structure IDs (Prisma has no optional lists). */
  targetFeeStructureIds String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId, termId])
  @@map("paystack_intents")
}

model Student {
  id          String    @id @default(cuid())
  studentId   String    @unique // School-issued ID e.g. STM-2025-001
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      Gender
  photo       String?   // Image of the child (URL or path)
  healthInsuranceCard String? // Photo/scan of insurance card (URL or path)
  address     String?
  parentName  String?   // Quick contact (no portal account needed)
  parentPhone String?   // Quick contact phone
  parent2Name String?   // Second guardian (e.g. father / mother)
  parent2Phone String?  // Second guardian phone — also grants parent portal access
  isActive    Boolean   @default(true)
  enrolledAt  DateTime  @default(now())

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id])

  attendances      Attendance[]
  results          Result[]
  feePayments      FeePayment[]
  paystackIntents  PaystackIntent[]
  assessmentScores AssessmentScore[]
  termRemarks      TermRemarks[]
  studentProfile   StudentProfile?
  bookAssignments  BookAssignment[]
  bookPayments     BookPayment[]
  bookPaystackIntents BookPaystackIntent[]
  examAttempts     ExamAttempt[]

  @@map("students")
}

enum Gender {
  MALE
  FEMALE
}

// ─────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────

model Class {
  id          String     @id @default(cuid())
  name        String     // display name e.g. "Class 3"
  classNumber Int        @unique // used in student IDs e.g. DASE-7-001
  level       ClassLevel
  section     String?    // "A", "B"

  classTeacherId String?  @unique
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students        Student[]
  subjectTeachers SubjectTeacher[]
  timetables      Timetable[]
  assessments     Assessment[]
  digitalMaterials DigitalMaterial[]
  bookAssignments BookAssignment[]
  onlineExams     OnlineExam[]

  @@unique([level, section])
  @@map("classes")
}

enum ClassLevel {
  CRECHE
  NURSERY_1
  NURSERY_2
  KG_1
  KG_2
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
  YEAR_7
  YEAR_8
  BASIC_1
  BASIC_2
  BASIC_3
  BASIC_4
  BASIC_5
  BASIC_6
  JHS_1
  JHS_2
  JHS_3
}

// ─────────────────────────────────────────
// SUBJECT
// ─────────────────────────────────────────

model Subject {
  id   String  @id @default(cuid())
  name String  @unique // "Mathematics"
  code String? // "MATH"

  subjectTeachers SubjectTeacher[]
  results         Result[]
  timetables      Timetable[]
  assessments     Assessment[]
  digitalMaterials DigitalMaterial[]
  onlineExams     OnlineExam[]

  @@map("subjects")
}

// ─────────────────────────────────────────
// SUBJECT TEACHER (who teaches what to whom)
// ─────────────────────────────────────────

model SubjectTeacher {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])

  @@unique([teacherId, subjectId, classId])
  @@map("subject_teachers")
}

// ─────────────────────────────────────────
// STUDENT ATTENDANCE
// ─────────────────────────────────────────

model Attendance {
  id     String           @id @default(cuid())
  date   DateTime         @db.Date
  status AttendanceStatus
  note   String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  @@unique([studentId, date])
  @@map("attendance")
}

// ─────────────────────────────────────────
// TEACHER ATTENDANCE (auto-tracked on login)
// ─────────────────────────────────────────

model TeacherAttendance {
  id       String           @id @default(cuid())
  date     DateTime         @db.Date
  status   AttendanceStatus
  checkIn  DateTime?
  checkOut DateTime?
  note     String?

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  @@unique([teacherId, date])
  @@map("teacher_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ─────────────────────────────────────────
// RESULTS / GRADES
// ─────────────────────────────────────────

model Result {
  id         String  @id @default(cuid())
  classScore Float?  // legacy — kept for backwards compat
  examScore  Float?  // legacy
  totalScore Float?  // final computed score out of 100
  grade      String? // A1, B2 … F9
  position   Int?    // rank in class for this subject
  remarks    String?
  isPromoted Boolean?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@map("results")
}

// ─────────────────────────────────────────
// ASSESSMENTS (tests & exams per subject)
// ─────────────────────────────────────────

model Assessment {
  id          String         @id @default(cuid())
  name        String         // "Class Test 1", "Final Examination"
  type        AssessmentType
  date        DateTime?
  totalMark   Float          // Max score e.g. 50, 100

  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  createdById String   // User ID of teacher who created it

  scores     AssessmentScore[]
  components TermResultComponent[]
  createdAt  DateTime @default(now())

  @@map("assessments")
}

enum AssessmentType {
  TEST
  EXAM
}

model AssessmentScore {
  id    String @id @default(cuid())
  score Float? // null = absent (shown as ABS, counted as 0)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@map("assessment_scores")
}

// ─────────────────────────────────────────
// TERM RESULT (end-of-term generation config + publication)
// ─────────────────────────────────────────

model TermResult {
  id          String    @id @default(cuid())
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  publishedBy String?   // Admin user ID

  classId String
  termId  String

  components TermResultComponent[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([classId, termId])
  @@map("term_results")
}

// Which assessment contributes to a subject's final score, and at what weight
model TermResultComponent {
  id     String @id @default(cuid())
  weight Float  // Contribution out of 100 per subject

  termResultId String
  termResult   TermResult @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([termResultId, assessmentId])
  @@map("term_result_components")
}

// ─────────────────────────────────────────
// TERM REMARKS (teacher + headmaster per student)
// ─────────────────────────────────────────

model TermRemarks {
  id                String    @id @default(cuid())
  teacherRemarks    String?
  headmasterRemarks String?
  nextTermBegins    DateTime?

  studentId String                                                                                                              
  student   Student @relation(fields: [studentId], references: [id])
  termId    String
  term      Term    @relation(fields: [termId], references: [id]) 
  classId   String

  @@unique([studentId, termId])
  @@map("term_remarks")
}

// ─────────────────────────────────────────
// FEE STRUCTURE
// ─────────────────────────────────────────

enum FeeCategory {
  TUITION  // Main term school fee (one per class level per term for overview)
  UNIFORM
  OTHER    // Robotics, maintenance, graduation, etc.
}

model FeeStructure {
  id         String      @id @default(cuid())
  name       String      // "Basic 1-3 Fees" / "Robotics" / "Uniform"
  amount     Float       // GHS
  category   FeeCategory @default(TUITION)
  notes      String?     // e.g. "KG1–JHS" — display only
  classLevel ClassLevel?

  termId String?
  term   Term?   @relation(fields: [termId], references: [id])

  feePayments FeePayment[]

  @@map("fee_structures")
}

// ─────────────────────────────────────────
// FEE PAYMENT
// ─────────────────────────────────────────

model FeePayment {
  id            String        @id @default(cuid())
  amountPaid    Float
  paymentStatus PaymentStatus
  paymentMethod String?       // "cash", "momo", "bank"
  receiptNumber String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  termId String
  term   Term   @relation(fields: [termId], references: [id])

  @@map("fee_payments")
}

enum PaymentStatus {
  FULLY_PAID
  HALF_PAID
  PARTIAL
  UNPAID
}

// ─────────────────────────────────────────
// PERMISSION REQUESTS (teacher leave)
// ─────────────────────────────────────────

model PermissionRequest {
  id        String         @id @default(cuid())
  type      PermissionType
  reason    String
  startDate DateTime
  endDate   DateTime
  status    RequestStatus  @default(PENDING)
  adminNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("permission_requests")
}

enum PermissionType {
  SICK_LEAVE
  PERSONAL_LEAVE
  MATERNITY_LEAVE
  PATERNITY_LEAVE
  STUDY_LEAVE
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// ANNOUNCEMENTS
// ─────────────────────────────────────────

model Announcement {
  id             String         @id @default(cuid())
  title          String
  content        String         
  targetAudience TargetAudience 
  authorId       String         
  author         User           @relation(fields: [authorId], references: [id])
  createdAt      DateTime       @default(now())

  @@map("announcements")
}

/// Expo push tokens for parent app (FCM on Android, APNs on iOS via Expo/EAS)
model PushToken {
  id          String   @id @default(cuid())
  token       String   @unique
  platform    String   // ios | android | web
  parentPhone String   // normalized 0XXXXXXXXX
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentPhone])
  @@map("push_tokens")
}

enum TargetAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─────────────────────────────────────────
// DIGITAL MATERIALS
// ─────────────────────────────────────────

model DigitalMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  createdAt   DateTime @default(now())

  @@map("digital_materials")
}

// ─────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────

model Timetable {
  id        String @id @default(cuid())
  dayOfWeek Int    // 1=Mon … 5=Fri
  startTime String // "08:00"
  endTime   String // "09:00"

  classId String
  class   Class   @relation(fields: [classId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, dayOfWeek, startTime])
  @@map("timetable")
}

// ─────────────────────────────────────────
// TEXTBOOK LIBRARY
// ─────────────────────────────────────────

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  isbn        String?
  description String?
  priceGhs    Float
  coverUrl    String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments BookAssignment[]
  payments    BookPayment[]

  @@map("books")
}

model BookAssignment {
  id         String  @id @default(cuid())
  bookId     String
  book       Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  classId    String?
  class      Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId     String
  term       Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  isRequired Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([bookId, classId, termId])
  @@index([bookId, studentId, termId])
  @@map("book_assignments")
}

model BookPayment {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  amountPaid    Float
  paymentStatus PaymentStatus @default(FULLY_PAID)
  paymentMethod String?
  paystackRef   String?
  paidAt        DateTime?
  termId        String
  term          Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([studentId, bookId, termId])
  @@map("book_payments")
}

model BookPaystackIntent {
  id                 String   @id @default(cuid())
  reference          String   @unique
  amountGhs          Float    // Gross charged to parent
  amountPesewas      Int
  schoolAmountGhs    Float    @default(0)
  platformFeeGhs     Float    @default(0)
  status             String   @default("PENDING")
  callbackUrl        String?
  studentId          String
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId             String
  term               Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  targetBookIds      String[] @default([])
  paystackAccessCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([studentId, termId])
  @@map("book_paystack_intents")
}

// ─────────────────────────────────────────
// ONLINE EXAMS (CBT)
// ─────────────────────────────────────────

enum ExamQuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  THEORY
}

enum OnlineExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model OnlineExam {
  id              String           @id @default(cuid())
  title           String
  description     String?
  instructions    String?
  durationMinutes Int
  startAt         DateTime?
  endAt           DateTime?
  totalMarks      Float            @default(0)
  status          OnlineExamStatus @default(DRAFT)
  resultsReleased Boolean          @default(false)
  classId         String
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId          String
  term            Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@map("online_exams")
}

model ExamQuestion {
  id          String           @id @default(cuid())
  examId      String
  exam        OnlineExam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  type        ExamQuestionType
  text        String
  marks       Float
  order       Int
  modelAnswer String?

  options ExamOption[]
  answers ExamAnswer[]

  @@map("exam_questions")
}

model ExamOption {
  id         String       @id @default(cuid())
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)

  @@map("exam_options")
}

model ExamAttempt {
  id          String            @id @default(cuid())
  examId      String
  exam        OnlineExam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  status      ExamAttemptStatus @default(IN_PROGRESS)
  score       Float?

  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id                String       @id @default(cuid())
  attemptId         String
  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]     @default([])
  textAnswer        String?
  marksAwarded      Float?
  gradedById        String?
  feedback          String?

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

// ─────────────────────────────────────────
// SCHOOL WALLET & PAYOUTS (Paystack settlements)
// ─────────────────────────────────────────

model SchoolWallet {
  id                 String   @id @default("default")
  availableBalanceGhs Float   @default(0)
  updatedAt          DateTime @updatedAt

  @@map("school_wallet")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayoutRequest {
  id              String       @id @default(cuid())
  amountGhs       Float
  status          PayoutStatus @default(PENDING)
  note            String?
  paystackTransferCode String?
  failureReason   String?
  requestedById   String
  requestedBy     User         @relation(fields: [requestedById], references: [id])
  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  @@map("payout_requests")
}
